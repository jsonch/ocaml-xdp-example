opam-version: "2.0"
name: "ocaml-xdp-example"
version: "0.1"
synopsis: "AF_XDP examples in ocaml"
depends: [
  "ocaml" {>= "4.10.0"}
  "dune" {>= "2.6"}
  "base"
  "core"
  "core_bench"
  "ppx_jane"
  "base_bigstring"
  "ppx_cstruct"
  "cstruct"
  "expect_test_helpers_kernel"
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
